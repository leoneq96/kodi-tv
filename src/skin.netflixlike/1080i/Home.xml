                </control>
            </control>
        </control>
        
        <!-- Side Menu -->
        <include content="Home_Menu">
            <param name="onlist">9011</param>
            <param name="window_id">Home</param>
            <param name="property_window_id">Home</param>
        </include>
    </controls>
</window>