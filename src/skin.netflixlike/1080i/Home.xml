                            <label>$INFO[ListItem.Title]</label>
                        </control>
                    </focusedlayout>
                    <content>plugin://plugin.video.themoviedb.helper/?info=upcoming&amp;tmdb_type=movie&amp;widget=true</content>
                </control>
            </control>

            <!-- Row 4: Series (Seriale) -->
            <control type="group" id="9030">
                <posx>0</posx>
                <posy>1380</posy>
                <include content="Row_Header">
                    <param name="button_id">9204</param>
                    <param name="label">Seriale</param>
                    <param name="action">ActivateWindow(Videos,plugin://plugin.video.themoviedb.helper/?info=trending_day&amp;tmdb_type=tv&amp;widget=true,return)</param>
                    <param name="list_id">9031</param>
