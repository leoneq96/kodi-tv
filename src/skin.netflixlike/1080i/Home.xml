    <onload condition="!Skin.HasSetting(Wizard.FirstRun)">AlarmClock(openwizard,ActivateWindow(1180),00:01,silent)</onload>
    <onload condition="!Skin.HasSetting(Home.FirstRun)">Skin.SetBool(Hub.Home.DisableSubmenu)</onload>
    <onload condition="!Skin.HasSetting(Home.FirstRun)">Skin.SetString(Shortcuts.RebuildDateTime,FirstRun)</onload>
    <onload condition="!Skin.HasSetting(Home.FirstRun)">Skin.SetBool(Home.FirstRun)</onload>
    <onload condition="!Skin.HasSetting(Home.FirstRun)">AlarmClock(reloadskin,ReloadSkin(),00:00,silent)</onload>
    
    <!-- NetflixLike: Trigger SkinVariables generator on Home load -->
    <onload>RunScript(script.skinvariables, run_executebuiltin=special://skin/shortcuts/skinvariables-build-templates.json, use_rules)</onload>

    <!-- NetflixLike: AF2 ustawia tu 100601 (kontrolka, ktorej u nas nie ma);
         menu 300 wraca w prawo do tego wlasnie id (lista Popularne) -->
    <onload>SetProperty(TMDbHelper.WidgetContainer,9011,Home)</onload>

    <!-- NetflixLike: ktory rzad karmi hero (fanart/tytul/opis) i przyciski Odtworz/Info.
         Ustawiane przy fokusie listy, zeby hero nie znikalo, gdy fokus wejdzie na przyciski. -->
    <onload>SetProperty(Hero.RowId,9011,Home)</onload>

    <onload>$VAR[Action_RatingsMonitor]</onload>

    <controls>
        <!-- NetflixLike: Hero Banner -->
        <include>Hero_Banner</include>

        <!-- NetflixLike: Horizontal Rows -->
        <control type="group">
            <posx>60</posx>
            <posy>440</posy>
            <!-- NetflixLike: fokus na rzędzie 3/4 -> cala grupa leci w gore, bez animacji -->
            <animation effect="slide" start="0,0" end="0,-260" time="0" condition="Control.HasFocus(9021)">Conditional</animation>
            <animation effect="slide" start="0,0" end="0,-520" time="0" condition="Control.HasFocus(9031)">Conditional</animation>
            
            <!-- Row 1: Continue Watching (Kontynuuj oglądanie) -->
            <control type="group" id="9000">
                <!-- Rzad "Kontynuuj ogladanie" znika, gdy nie ma czego pokazac:
                     puste container albo pierwsza pozycja bez plakatu (DefaultVideo.png). -->
                <visible>[!Integer.IsEqual(Container(9001).NumItems,0) + !String.IsEmpty(Container(9001).ListItemAbsolute(0).Art(poster))]</visible>
                <posx>0</posx>
                <posy>0</posy>
                <include content="Row_Header">
                    <param name="label">Kontynuuj oglądanie</param>
                    <param name="action">ActivateWindow(Videos,plugin://plugin.video.fanfilm/?action=continue_watching,return)</param>
                    <param name="button_id">9201</param>
                    <param name="list_id">9001</param>
                </include>
                <control type="list" id="9001">
                    <posx>0</posx>
                    <posy>50</posy>
                    <width>1800</width>
                    <height>200</height>
                    <scrolltime>200</scrolltime>
                    <orientation>horizontal</orientation>
                    <onfocus>SetProperty(Hero.RowId,9001,Home)</onfocus>
                    <onleft>300</onleft>
                    <onright>9201</onright>
                    <onup>9201</onup>
                    <ondown>9011</ondown>
                    <itemlayout width="145" height="205">
                        <control type="image">
                            <width>135</width>
                            <height>180</height>
                            <texture fallback="special://skin/extras/icons/video.png">$INFO[ListItem.Icon]</texture>
                            <aspectratio>keep</aspectratio>
                        </control>
                        <control type="label">
                            <posx>0</posx>
                            <posy>182</posy>
                            <width>135</width>
                            <height>22</height>
                            <font>font12</font>
                            <textcolor>white</textcolor>
                            <align>center</align>
                            <label>$INFO[ListItem.Label]</label>
                            <maxlines>1</maxlines>
                        </control>
                    </itemlayout>
                    <focusedlayout width="145" height="205">
                        <control type="image">
                            <width>135</width>
                            <height>180</height>
                            <texture fallback="special://skin/extras/icons/video.png">$INFO[ListItem.Icon]</texture>
                            <aspectratio>keep</aspectratio>
                            <include>Animation_Poster_Focus_Zoom</include>
                        </control>
                        <control type="label">
                            <posx>0</posx>
                            <posy>182</posy>
                            <width>135</width>
                            <height>22</height>
                            <font>font12_bold</font>
                            <textcolor>accent</textcolor>
                            <align>center</align>
                            <label>$INFO[ListItem.Label]</label>
                            <maxlines>1</maxlines>
                        </control>
                        <control type="image">
                            <posx>-5</posx>
                            <posy>-5</posy>
                            <width>145</width>
                            <height>205</height>
                            <texture>special://skin/extras/textures/selectbox_thin.png</texture>
                            <colordiffuse>accent</colordiffuse>
                        </control>
                    </focusedlayout>
                    <content target="widget">plugin://service.netflixlike.helper/widget/continue</content>
                </control>
            </control>

