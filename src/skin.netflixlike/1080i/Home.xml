                    <focusedlayout width="200" height="390">
                        <control type="image">
                            <posy>10</posy>
                            <width>200</width>
                            <height>300</height>
                            <texture fallback="special://skin/extras/icons/video.png">$INFO[ListItem.Icon]</texture>
                            <aspectratio>stretch</aspectratio>
                            <include>Animation_Row_Focus_Zoom</include>
                        </control>
                        <control type="textbox">
                            <visible>Control.HasFocus(9011)</visible>
                            <posx>-10</posx>
                            <posy>328</posy>
                            <width>220</width>
                            <height>56</height>
