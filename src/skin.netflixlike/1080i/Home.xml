                    <ondown>9001</ondown>
                    <itemgap>20</itemgap>
                    <!-- NetflixLike: plakat 200x300 (2:3); podpis tylko pod fokusowanym kafelkiem -->
                    <itemlayout width="200" height="390">
                        <control type="image">
                            <posy>10</posy>
                            <width>200</width>
