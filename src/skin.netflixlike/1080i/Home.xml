                            <align>center</align>
                            <autoscroll>false</autoscroll>
                            <label>$INFO[ListItem.Title]</label>
                        </control>
                    </focusedlayout>
                    <content>plugin://plugin.video.themoviedb.helper/?info=trending_day&amp;tmdb_type=movie&amp;widget=true</content>
                </control>
            </control>
                <param name="button_id">9203</param>

            <!-- Row 3: New Releases (Nowości) -->
            <control type="group" id="9020">
                <posx>0</posx>
                <posy>920</posy>
