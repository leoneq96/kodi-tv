        <param name="property_window_id">Home</param>
    </include>
    <include content="Action_Hubs_Onload" condition="Integer.IsEqual(Skin.String(Hub.Home.ReplaceWindow),1108)">
        <param name="window_id">1108</param>
        <param name="property_window_id">Home</param>
    </include>
    <include content="Action_Hubs_Onload" condition="Integer.IsEqual(Skin.String(Hub.Home.ReplaceWindow),1109)">
        <param name="window_id">1109</param>
        <param name="property_window_id">Home</param>
    </include>


    <onload condition="!Skin.HasSetting(Wizard.FirstRun)">AlarmClock(openwizard,ActivateWindow(1180),00:01,silent)</onload>
    <onload condition="!Skin.HasSetting(Home.FirstRun)">Skin.SetBool(Hub.Home.DisableSubmenu)</onload>
    <onload condition="!Skin.HasSetting(Home.FirstRun)">Skin.SetString(Shortcuts.RebuildDateTime,FirstRun)</onload>
    <onload condition="!Skin.HasSetting(Home.FirstRun)">Skin.SetBool(Home.FirstRun)</onload>
    <onload condition="!Skin.HasSetting(Home.FirstRun)">AlarmClock(reloadskin,ReloadSkin(),00:00,silent)</onload>
    
    <!-- NetflixLike: Trigger SkinVariables generator on Home load -->
    <onload>RunScript(script.skinvariables, run_executebuiltin=special://skin/shortcuts/skinvariables-build-templates.json, use_rules)</onload>

    <!-- NetflixLike: AF2 ustawia tu 100601 (kontrolka, ktorej u nas nie ma);
         menu 300 wraca w prawo do tego wlasnie id (lista Popularne) -->
    <onload>SetProperty(TMDbHelper.WidgetContainer,9011,Home)</onload>

    <!-- NetflixLike: ktory rzad karmi hero (fanart/tytul/opis) i przyciski Odtworz/Info.
         Ustawiane przy fokusie listy, zeby hero nie znikalo, gdy fokus wejdzie na przyciski. -->
    <onload>SetProperty(Hero.RowId,9001,Home)</onload>

    <onload>$VAR[Action_RatingsMonitor]</onload>

    <controls>
        <!-- NetflixLike: Hero Banner -->
        <include>Hero_Banner</include>

        <!-- NetflixLike: Horizontal Rows -->
        <control type="group">
            <posx>60</posx>
            <posy>400</posy>
            <!-- NetflixLike: hero ma 380 px, pierwszy rzad startuje na y=400.
                 Fokus na rzedzie 2/3/4 -> cala grupa wjezdza w gore o 440 px
                 na kazdy rzad, dzieki czemu fokusowany rzad jest zawsze na y=400. -->
            <animation effect="slide" start="0,0" end="0,-460" time="0" condition="[Control.HasFocus(9011) | Control.HasFocus(9202)]">Conditional</animation>
            <animation effect="slide" start="0,0" end="0,-920" time="0" condition="[Control.HasFocus(9021) | Control.HasFocus(9203)]">Conditional</animation>
            <animation effect="slide" start="0,0" end="0,-1380" time="0" condition="[Control.HasFocus(9031) | Control.HasFocus(9204)]">Conditional</animation>
            
            <!-- Row 1: Continue Watching (Kontynuuj oglądanie) -->
            <control type="group" id="9000">
                <!-- Rzad "Kontynuuj ogladanie" znika, gdy nie ma czego pokazac:
                     puste container albo pierwsza pozycja bez plakatu (DefaultVideo.png). -->
                <visible>[!Integer.IsEqual(Container(9001).NumItems,0) + !String.IsEmpty(Container(9001).ListItemAbsolute(0).Art(poster))]</visible>
                <posx>0</posx>
                <posy>0</posy>
                <include content="Row_Header">
                    <param name="label">Kontynuuj oglądanie</param>
                    <param name="action">ActivateWindow(Videos,plugin://plugin.video.fanfilm/?action=continue_watching,return)</param>
                    <param name="button_id">9201</param>
                    <param name="list_id">9001</param>
                    <param name="up_id">9103</param>
                </include>
                <control type="list" id="9001">
                    <posx>0</posx>
                    <posy>50</posy>
                    <width>1800</width>
                    <height>390</height>
                    <scrolltime>200</scrolltime>
                    <orientation>horizontal</orientation>
                    <onfocus>SetProperty(Hero.RowId,9001,Home)</onfocus>
                    <onleft>300</onleft>
                    <onright>9201</onright>
                    <onup>9201</onup>
                    <ondown>9011</ondown>
                    <itemgap>20</itemgap>
                    <!-- NetflixLike: plakat 200x300 (2:3); podpis tylko pod fokusowanym kafelkiem -->
                    <itemlayout width="200" height="390">
                        <control type="image">
                            <posy>10</posy>
                            <width>200</width>
                            <height>300</height>
                            <texture fallback="special://skin/extras/icons/video.png">$INFO[ListItem.Icon]</texture>
                            <aspectratio>stretch</aspectratio>
                        </control>
                    </itemlayout>
                    <focusedlayout width="200" height="390">
                        <control type="image">
                            <posy>10</posy>
                            <width>200</width>
                            <height>300</height>
                            <texture fallback="special://skin/extras/icons/video.png">$INFO[ListItem.Icon]</texture>
                            <aspectratio>stretch</aspectratio>
                            <include>Animation_Row_Focus_Zoom</include>
                        </control>
                        <control type="textbox">
                            <visible>Control.HasFocus(9001)</visible>
                            <posx>-10</posx>
                            <posy>328</posy>
                            <width>220</width>
                            <height>56</height>
                            <font>font_tiny</font>
                            <textcolor>white</textcolor>
                            <shadowcolor>black</shadowcolor>
                            <align>center</align>
                            <autoscroll>false</autoscroll>
                            <label>$INFO[ListItem.Title]</label>
                        </control>
                    </focusedlayout>
                    <content target="widget">plugin://service.netflixlike.helper/widget/continue</content>
                </control>
            </control>

            <!-- Row 2: Popular (Popularne) -->
            <control type="group" id="9010">
                <posx>0</posx>
                <posy>460</posy>
                <include content="Row_Header">
                    <param name="button_id">9202</param>
                    <param name="label">Popularne</param>
                    <param name="action">ActivateWindow(Videos,plugin://plugin.video.themoviedb.helper/?info=trending_day&amp;tmdb_type=movie&amp;widget=true,return)</param>
                    <param name="list_id">9011</param>
                    <param name="up_id">9103</param>
