            <!-- Row 1: Continue Watching -->
            <control type="group" id="9000">
                <posx>0</posx>
                <posy>0</posy>
                <include>Row_Header</include>
                <param name="label">$LOCALIZE[31128]</param> <!-- Continue Watching -->
                <param name="action">ActivateWindow(Videos,plugin://plugin.video.fanfilm/?action=continue_watching,return)</param>
                <control type="list" id="9001">
                    <posx>0</posy>
                    <posy>50</posy>
                    <width>1800</width>
                    <height>300</height>
                    <scrolltime>200</scrolltime>
                    <orientation>horizontal</orientation>
                    <itemlayout width="240" height="280">
                        <control type="image">
                            <width>220</width>
                            <height>310</height>
                            <texture fallback="special://skin/extras/icons/video.png">$INFO[ListItem.Icon]</texture>
                            <aspectratio>keep</aspectratio>
                        </control>
                        <control type="label">
                            <posx>0</posx>
                            <posy>320</posy>
                            <width>220</width>
                            <height>30</height>
                            <font>font12</font>
                            <textcolor>white</textcolor>
                            <align>center</align>
                            <label>$INFO[ListItem.Label]</label>
                            <maxlines>2</maxlines>
                        </control>
                    </itemlayout>
                    <focusedlayout width="240" height="280">
                        <control type="image">
                            <width>220</width>
                            <height>310</height>
                            <texture fallback="special://skin/extras/icons/video.png">$INFO[ListItem.Icon]</texture>
