                            <height>330</height>
                            <texture>special://skin/extras/textures/selectbox_thin.png</texture>
                            <colordiffuse>accent</colordiffuse>
                        </control>
                    </focusedlayout>
                    <content>
                        <item>
                            <label>$LOCALIZE[31128]</label>
                            <path>plugin://plugin.video.fanfilm/?action=continue_watching</path>
                            <icon>special://skin/extras/icons/recentlyadded.png</icon>
