<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.netflixlike.helper"
       name="NetflixLike Helper"
       version="1.0.0"
       provider-name="NetflixLike Project">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.script" library="resources/lib/script_entry.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.service" library="resources/lib/service_entry.py"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">NetflixLike Helper Service</summary>
        <description lang="en">Service addon for NetflixLike skin. Provides My List (custom list with context menu add/remove), Continue Watching (from Kodi library and FanFilm history), and Netflix-style profile selection based on Kodi profiles. Exposes widget sources for NetflixLike skin.</description>
        <platform>all</platform>
        <license>GPL-3.0</license>
    </extension>
</addon>